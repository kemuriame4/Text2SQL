-- 【文件说明】mysql/mysql1022 —— 草稿：给 t_column_info 加一个测试列 a
-- 性质：不是业务增删改查 SQL，只是练习/测试用的 ALTER TABLE（修改表结构）语句。
-- 配套：同目录 mysql1022.back 是它的反向操作（把这一列删掉）。
-- ============================================================================

-- 给"字段信息表"增加一列 a：类型 varchar(255)（最多 255 个字符），可为空，并排在 update_by 列后面
ALTER TABLE `t_column_info`  -- ALTER TABLE：修改已有的表结构（不是改数据）
ADD COLUMN `a` varchar(255) NULL COMMENT 'a' AFTER `update_by`;  -- ADD COLUMN 加列；AFTER 指定新列的位置

-- 【注意】下面 3 个词是"没写完的 SQL 开头"（缺表名、缺条件/值），单独执行会报错，
--         属于草稿残留，不是可执行语句
insert into
update
delete