-- ============================================================================
-- 【文件说明】mysql/initmysql —— 元数据库的建表脚本（手写小抄，文件没有扩展名）
-- 作用：在 meta_1022 这个库里建 4 张"元数据表"，存表、字段、指标的定义。
-- 说明：-- 是 SQL 的单行注释，MySQL 里 -- 后面必须跟一个空格。
-- 执行：连上 MySQL 后整段执行即可；语句带 IF NOT EXISTS，重复执行不会报错。
-- 表关系：t_table_info（表）1—N t_column_info（字段）；
--         t_column_info 与 t_metric_info 通过 t_column_metric（多对多关联表）连起来。
-- ============================================================================

-- 第 1 张表：t_table_info（表信息表）—— 一行记录一张维表/事实表的基本信息
CREATE TABLE IF NOT EXISTS `t_table_info` (
  `id` varchar(32) COLLATE utf8mb4_general_ci NOT NULL COMMENT '主键',
  `name` varchar(64) COLLATE utf8mb4_general_ci DEFAULT NULL COMMENT '名称',
  `role` char(1) COLLATE utf8mb4_general_ci DEFAULT NULL COMMENT '角色 0:维度表  1 事实表',  -- 用一位字符区分维度表/事实表
  `description` varchar(255) COLLATE utf8mb4_general_ci DEFAULT NULL COMMENT '描述',
  `del_flag` char(1) COLLATE utf8mb4_general_ci DEFAULT NULL COMMENT '是否删除 0 未删除  1 已删除',  -- del_flag：软删除标记（数据不真删，只改标记）
  `create_time` datetime DEFAULT NULL COMMENT '创建时间',
  `create_by` varchar(64) COLLATE utf8mb4_general_ci DEFAULT NULL COMMENT '创建者',
  `update_time` datetime DEFAULT NULL COMMENT '修改时间',
  `update_by` varchar(255) COLLATE utf8mb4_general_ci DEFAULT NULL COMMENT '修改者',
  PRIMARY KEY (`id`)  -- 主键：保证 id 唯一，一条记录一个 id
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci COMMENT='表信息';  -- InnoDB 是存储引擎；utf8mb4 支持中文和表情


-- 第 2 张表：t_metric_info（指标信息表）—— 一行记录一个业务指标，如 GMV、AOV
CREATE TABLE IF NOT EXISTS `t_metric_info` (
  `id` varchar(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NOT NULL COMMENT '指标编码',
  `name` varchar(128) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci DEFAULT NULL COMMENT '指标名称',
  `description` text CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci COMMENT '指标描述',
  `relevant_columns` json DEFAULT NULL COMMENT '关联的列',  -- JSON 数组：算这个指标要用到哪些字段
  `alias` json DEFAULT NULL COMMENT '指标别名',  -- JSON 数组：指标的同义词
  `del_flag` char(1) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci DEFAULT NULL COMMENT '是否删除 0 未删除  1 已删除',
  `create_time` datetime DEFAULT NULL COMMENT '创建时间',
  `create_by` varchar(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci DEFAULT NULL COMMENT '创建者',
  `update_time` datetime DEFAULT NULL COMMENT '修改时间',
  `update_by` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci DEFAULT NULL COMMENT '修改者',
  PRIMARY KEY (`id`)  -- 主键：指标编码唯一
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;  -- 注意：这张表没写表级 COMMENT='...'，跟其他 3 张风格不一致（不影响功能）


-- 第 3 张表：t_column_metric（字段-指标关联表）—— 多对多中间表：
--   一个指标可能用到多个字段，一个字段也可能被多个指标用，所以单独建表存这种关系
CREATE TABLE IF NOT EXISTS `t_column_metric` (
  `column_id` varchar(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NOT NULL COMMENT '列编号',  -- 指向 t_column_info.id
  `metric_id` varchar(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NOT NULL COMMENT '指标编号',  -- 指向 t_metric_info.id
  `del_flag` char(1) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci DEFAULT NULL COMMENT '是否删除 0 未删除  1 已删除',
  `create_time` datetime DEFAULT NULL COMMENT '创建时间',
  `create_by` varchar(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci DEFAULT NULL COMMENT '创建者',
  `update_time` datetime DEFAULT NULL COMMENT '修改时间',
  `update_by` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci DEFAULT NULL COMMENT '修改者',
  PRIMARY KEY (`column_id`,`metric_id`)  -- 联合主键：同一对"字段+指标"只能出现一次，天然防重复
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;


-- 第 4 张表：t_column_info（字段信息表）—— 一行记录一个字段（列）的定义，是 4 张表里最核心的
CREATE TABLE IF NOT EXISTS `t_column_info` (
  `id` varchar(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NOT NULL COMMENT '列编号',
  `name` varchar(128) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci DEFAULT NULL COMMENT '列名称',
  `type` varchar(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci DEFAULT NULL COMMENT '数据类型',  -- 如 varchar/int/decimal，帮大模型判断能否做计算
  `role` varchar(32) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci DEFAULT NULL COMMENT '列类型(primary_key,foreign_key,measure,dimension)',  -- 四种角色，和 meta_config.yaml 里的 role 一一对应
  `examples` json DEFAULT NULL COMMENT '数据示例',  -- JSON 数组：这一列真实长什么样（帮助理解 + 检索）
  `description` text CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci COMMENT '列描述',
  `alias` json DEFAULT NULL COMMENT '列别名',  -- JSON 数组：字段的同义词
  `table_id` varchar(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci DEFAULT NULL COMMENT '所属表编号',  -- 外键：指向 t_table_info.id，表示这个字段属于哪张表
  `del_flag` char(1) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci DEFAULT NULL COMMENT '是否删除 0 未删除  1 已删除',
  `create_time` datetime DEFAULT NULL COMMENT '创建时间',
  `create_by` varchar(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci DEFAULT NULL COMMENT '创建者',
  `update_time` datetime DEFAULT NULL COMMENT '修改时间',
  `update_by` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci DEFAULT NULL COMMENT '修改者',
  PRIMARY KEY (`id`)  -- 主键：列编号唯一
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;