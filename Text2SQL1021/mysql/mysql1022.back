-- ============================================================================
-- 【文件说明】mysql/mysql1022.back —— 撤销 mysql1022 那次加列的操作
-- 作用：把测试列 a 从 t_column_info 表里删掉，恢复原来的表结构。
-- 【注意】.back 在这里不是"备份文件"，也不是"事务回滚"，只是人工写的反向操作草稿；
--         文件名是习惯命名，什么时候执行全靠人记得。
-- 【注意】删列会连同这一列的数据一起丢失，执行前要确认。
-- ============================================================================

-- 修改"字段信息表"的结构
ALTER TABLE `t_column_info`
DROP COLUMN `a`;  -- DROP COLUMN：删除名为 a 的列（连同数据）

-- 【注意】下面的 delete/update/insert 是没写完的草稿关键字，不能执行
delete
update
insert
